{
  "name": "nuxt-penumbra-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun run --filter playground-color-mode dev",
    "prepare": "bun run --filter nuxt-penumbra prepare",
    "build:lib": "bun run --filter nuxt-penumbra build",
    "build": "bun run build:lib && bun run --filter playground-color-mode build",
    "test": "bun run --filter nuxt-penumbra test",
    "test:coverage": "bun run --filter nuxt-penumbra test:coverage",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-vue": "^10",
    "globals": "^17.13.0",
    "playwright": "^1.65.1",
    "prettier": "^3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8"
  }
}
