{
  "name": "nuxt-penumbra",
  "version": "1.0.1",
  "description": "Nuxt module for animated theme switching on View Transitions: circle reveal, wipe, blinds and more. Works with @nuxtjs/color-mode and Nuxt UI, or on its own.",
  "license": "MIT",
  "author": {
    "name": "Jan Tursky",
    "email": "jan.tursky@gmail.com",
    "url": "https://jantursky.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jantursky/nuxt-penumbra.git",
    "directory": "packages/nuxt-penumbra"
  },
  "bugs": {
    "url": "https://github.com/jantursky/nuxt-penumbra/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "color-mode",
    "dark-mode",
    "theme",
    "view-transitions",
    "theme-transition"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "prepack": "nuxt-module-build build",
    "build": "nuxt-module-build build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint:package": "publint --strict",
    "test:pack": "node scripts/pack-test.js",
    "size": "node scripts/measure-size.js && size-limit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.4",
    "penumbra-core": "^1.0.0"
  },
  "peerDependencies": {
    "@nuxtjs/color-mode": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxtjs/color-mode": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.6.4",
    "@nuxtjs/color-mode": "^4.1.0",
    "@size-limit/esbuild": "^14",
    "@size-limit/file": "^14",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^5",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.6.4",
    "publint": "^0.3.25",
    "size-limit": "^14",
    "typescript": "~5.9.3",
    "vitest": "^5",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
